{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weave-common.schema.json",
  "title": "weave 공통 정의",
  "description": "타입·모양·원시 요소·주석의 닫힌 어휘. 이 파일이 렌더가 의존하는 전부다.",
  "$defs": {
    "Version": {
      "description": "스키마 버전. 지금은 1 뿐이다.",
      "const": "1"
    },
    "Key": {
      "description": "템플릿이 짓는 이름. facet id · 필드 key · 열 key 가 쓴다.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 48
    },
    "ExternalId": {
      "description": "바깥에서 온 식별자. 템플릿 id 와 subject id 가 쓴다.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "Type": {
      "description": "값의 타입. 렌더는 이 여덟에만 의존한다.",
      "enum": ["number", "money", "ratio", "duration", "age", "boolean", "text", "date"]
    },
    "NumericType": {
      "description": "크기를 견줄 수 있는 타입.",
      "enum": ["number", "money", "ratio", "duration", "age"]
    },
    "OrderedType": {
      "description": "순서를 매길 수 있는 타입. range 와 series 축이 쓴다.",
      "enum": ["number", "money", "ratio", "duration", "age", "date"]
    },
    "AxisType": {
      "description": "series 의 가로축이 될 수 있는 타입.",
      "enum": ["age", "date", "duration", "number"]
    },
    "Shape": {
      "description": "한 필드가 담는 값의 모양.",
      "enum": ["single", "range", "series", "items"]
    },
    "Element": {
      "description": "원시 요소. 렌더가 구현하는 것은 이 다섯이다.",
      "enum": ["stat", "facts", "bars", "line", "list"]
    },
    "Number": {
      "description": "숫자. 기본 단위 없음.",
      "type": "number"
    },
    "Money": {
      "description": "금액. 기본 단위 원, 정수.",
      "type": "integer"
    },
    "Ratio": {
      "description": "비율. 기본 단위 분수(0.5 = 50%).",
      "type": "number"
    },
    "Duration": {
      "description": "기간. 기본 단위 개월, 정수(20년 = 240).",
      "type": "integer"
    },
    "Age": {
      "description": "나이. 기본 단위 세, 정수.",
      "type": "integer"
    },
    "Boolean": {
      "description": "참거짓.",
      "type": "boolean"
    },
    "Text": {
      "description": "글. 긴 설명은 값이 아니라 주석에 둔다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Date": {
      "description": "날짜. ISO 8601 YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Scalar": {
      "description": "타입을 모르는 자리에서 쓰는 느슨한 홑값. 정확한 판정은 선언된 타입으로 한다.",
      "type": ["number", "boolean", "string"],
      "maxLength": 2000
    },
    "AnnotationKind": {
      "description": "주석의 갈래. 넷뿐이고 확실성 수치는 없다.",
      "enum": ["quote", "tip", "note", "caution"]
    },
    "Annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "$ref": "#/$defs/AnnotationKind" },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 }
      }
    },
    "Annotations": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/Annotation" }
    }
  }
}
