{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weave-common.schema.json",
  "title": "weave 공통 정의",
  "description": "타입·모양·primitive element·주석의 닫힌 어휘. 이 파일이 렌더가 의존하는 전부다.",
  "$defs": {
    "Version": {
      "description": "스키마 버전. 지금은 1 뿐이다.",
      "const": "1"
    },
    "Key": {
      "description": "템플릿이 짓는 이름. facet id · 필드 key · 열 key 가 쓴다.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 48
    },
    "ExternalId": {
      "description": "바깥에서 온 식별자. 템플릿 id 와 subject id 가 쓴다.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "Type": {
      "description": "값의 타입. 렌더는 이 닫힌 목록에만 의존한다.",
      "enum": ["number", "money", "ratio", "multiple", "duration", "age", "boolean", "text", "date"]
    },
    "NumericType": {
      "description": "크기를 견줄 수 있는 타입.",
      "enum": ["number", "money", "ratio", "multiple", "duration", "age"]
    },
    "OrderedType": {
      "description": "순서를 매길 수 있는 타입. range 와 series 축이 쓴다.",
      "enum": ["number", "money", "ratio", "multiple", "duration", "age", "date"]
    },
    "AxisType": {
      "description": "series 의 가로축이 될 수 있는 타입.",
      "enum": ["age", "date", "duration", "number"]
    },
    "Shape": {
      "description": "한 필드가 담는 값의 모양.",
      "enum": ["single", "range", "series", "items"]
    },
    "Element": {
      "description": "primitive element. 렌더가 구현하는 것은 이 목록뿐이다.",
      "enum": ["stat", "facts", "bars", "line", "rows", "parts"]
    },
    "Compare": {
      "description": "`rows` 가 항목을 겹칠지 고른 것만 펼지. `focus` 는 지금 보는 subject 의 항목만 행으로 펴고, `overlay` 는 항목을 이름으로 겹쳐 subject 마다 열을 세운다. rows 만 갖는다 — 한 facet 은 비교 축 하나이므로 이 값이 그 축을 말한다.",
      "enum": ["focus", "overlay"]
    },
    "Number": {
      "description": "숫자. 기본 단위 없음.",
      "type": "number"
    },
    "Money": {
      "description": "금액. 기본 단위 원, 정수.",
      "type": "integer"
    },
    "Ratio": {
      "description": "비율. 기본 단위 분수(0.5 = 50%).",
      "type": "number"
    },
    "Multiple": {
      "description": "배수. 1 이 「낸 만큼」이고 2 가 「두 배」다. 비율(ratio)과 다르다 — 0.049 가 4.9% 이고 4.9 가 4.9 배다.",
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "Duration": {
      "description": "기간. 기본 단위 개월, 정수(20년 = 240).",
      "type": "integer"
    },
    "Age": {
      "description": "나이. 기본 단위 세, 정수.",
      "type": "integer"
    },
    "Boolean": {
      "description": "참거짓.",
      "type": "boolean"
    },
    "Text": {
      "description": "글. 긴 설명은 값이 아니라 주석에 둔다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Date": {
      "description": "날짜. ISO 8601 YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Scalar": {
      "description": "타입을 모르는 자리에서 쓰는 느슨한 홑값. 정확한 판정은 선언된 타입으로 한다.",
      "type": ["number", "boolean", "string"],
      "maxLength": 2000
    },
    "AnnotationKind": {
      "description": "주석의 갈래. 넷뿐이고 확실성 수치는 없다.",
      "enum": ["quote", "tip", "note", "caution"]
    },
    "Annotation": {
      "description": "주석 하나. 갈래와 글뿐이고 확실성 수치는 없다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "$ref": "#/$defs/AnnotationKind" },
        "text": {
          "description": "주석의 글. 한 문단까지다 — 더 길어지면 값이 아니라 문서가 된다.",
          "type": "string", "minLength": 1, "maxLength": 600
        }
      }
    },
    "Annotations": {
      "description": "한 자리에 붙는 주석들. 템플릿 쪽에 서면 저작자의 말이고 값 한 벌 쪽에 서면 그 subject 에 대한 말이다.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/Annotation" }
    }
  }
}
