{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weave-valueset.schema.json",
  "title": "값 한 벌",
  "description": "subject 하나에 대한 필드별 상태와 값과 주석. subject 하나당 한 벌이다. 아직 채워지지 않은 subject 는 이 문서 자체가 없다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["weave", "templateId", "subjectId", "facets"],
  "properties": {
    "weave": { "$ref": "weave-common.schema.json#/$defs/Version" },
    "templateId": { "$ref": "weave-common.schema.json#/$defs/ExternalId" },
    "subjectId": { "$ref": "weave-common.schema.json#/$defs/ExternalId" },
    "subjectLabel": {
      "description": "이 subject 의 이름. 없으면 subjectId 가 이름을 대신한다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "facets": {
      "description": "템플릿의 facet id 를 키로. 빠짐도 덤도 없이 전부 덮는다.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
      "additionalProperties": { "$ref": "#/$defs/FacetValues" }
    }
  },
  "$defs": {
    "FacetValues": {
      "description": "facet 하나에 대한 이 subject 의 값들. 라벨은 갖지 않는다 — 제목과 이름은 전부 템플릿에서 온다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "description": "템플릿이 이 facet 에 선언한 필드 key 를 키로. 빠짐도 덤도 없이 전부 덮는다.",
          "type": "object",
          "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
          "additionalProperties": { "$ref": "#/$defs/FieldSlot" }
        },
        "notes": {
          "description": "이 subject 의 이 facet 전체에 대해 할 말. subject 와 무관한 지식은 템플릿 쪽 notes 에 둔다.",
          "$ref": "weave-common.schema.json#/$defs/Annotations"
        }
      }
    },
    "FieldSlot": {
      "description": "필드 한 자리. 고르는 자리를 타지 않는 필드면 값 하나이고, 템플릿이 choice 를 단 필드면 byOption 으로 고를 것마다 하나다. **어느 쪽이어야 하는지는 템플릿이 정한다** — 여기서는 둘 다 받고, 대조는 검사기가 한다. 고른 값 안에 또 고를 것을 둘 수는 없다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "description": "이 자리가 찼는지. 값의 것이다 — 템플릿은 자리가 선다는 것만 말하고 찼는지는 채운 쪽만 안다.",
          "enum": ["filled", "empty"]
        },
        "value": { "$ref": "#/$defs/Value" },
        "notes": {
          "description": "이 값 하나에 대해 할 말.",
          "$ref": "weave-common.schema.json#/$defs/Annotations"
        },
        "byOption": {
          "description": "고르는 자리의 고를 것마다 따로 있는 값. 키는 그 자리의 option id 이고 빠짐도 덤도 없이 전부 덮는다.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
          "additionalProperties": { "$ref": "#/$defs/FieldValue" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["byOption"] },
          "then": {
            "not": { "anyOf": [{ "required": ["state"] }, { "required": ["value"] }, { "required": ["notes"] }] }
          }
        },
        {
          "if": { "not": { "required": ["byOption"] } },
          "then": { "$ref": "#/$defs/FieldValue" }
        }
      ]
    },
    "FieldValue": {
      "description": "상태는 filled 와 empty 둘뿐이다. 왜 비었는지는 주석이 글로 말한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "description": "이 자리가 찼는지. filled 면 value 가 있고 empty 면 없다.",
          "enum": ["filled", "empty"]
        },
        "value": { "$ref": "#/$defs/Value" },
        "notes": {
          "description": "이 값 하나에 대해 할 말. 왜 비었는지도 여기에 글로 적는다.",
          "$ref": "weave-common.schema.json#/$defs/Annotations"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "filled" } }, "required": ["state"] },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "state": { "const": "empty" } }, "required": ["state"] },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "Value": {
      "description": "선언된 shape 를 모르는 자리에서 쓰는 느슨한 합집합. 정확한 판정은 검사기가 템플릿을 들고 한다.",
      "anyOf": [
        { "$ref": "#/$defs/ValueSingle" },
        { "$ref": "#/$defs/ValueRange" },
        { "$ref": "#/$defs/ValueSeries" },
        { "$ref": "#/$defs/ValueItems" }
      ]
    },
    "ValueSingle": { "$ref": "weave-common.schema.json#/$defs/Scalar" },
    "ValueRange": {
      "description": "구간. 한쪽만 알아도 담는다.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": { "$ref": "weave-common.schema.json#/$defs/Scalar" },
        "max": { "$ref": "weave-common.schema.json#/$defs/Scalar" }
      }
    },
    "ValueSeries": {
      "description": "축 위의 점들. at 은 오름차순이고 겹치지 않는다.",
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "value"],
        "properties": {
          "at": {
            "description": "가로축 위의 자리. 필드가 선언한 axis 의 타입으로 읽는다.",
            "$ref": "weave-common.schema.json#/$defs/Scalar"
          },
          "value": {
            "description": "그 자리의 값. 필드가 선언한 type 으로 읽는다.",
            "$ref": "weave-common.schema.json#/$defs/Scalar"
          }
        }
      }
    },
    "ValueItems": {
      "description": "반복 항목. 각 항목은 선언된 열의 부분집합을 채운다. 없는 열은 빈 칸이다.",
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
        "additionalProperties": { "$ref": "weave-common.schema.json#/$defs/Scalar" }
      }
    }
  }
}
