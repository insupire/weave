{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weave-valueset.schema.json",
  "title": "값 한 벌",
  "description": "subject 하나에 대한 필드별 상태와 값과 주석. 분석 Procedure 가 subject 하나당 한 벌을 낸다. 아직 분석되지 않은 subject 는 이 문서 자체가 없다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["weave", "templateId", "subjectId", "facets"],
  "properties": {
    "weave": { "$ref": "weave-common.schema.json#/$defs/Version" },
    "templateId": { "$ref": "weave-common.schema.json#/$defs/ExternalId" },
    "subjectId": { "$ref": "weave-common.schema.json#/$defs/ExternalId" },
    "subjectLabel": {
      "description": "화면에 쓸 이름. 없으면 렌더가 subjectId 를 쓴다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "facets": {
      "description": "템플릿의 facet id 를 키로. 빠짐도 덤도 없이 전부 덮는다.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
      "additionalProperties": { "$ref": "#/$defs/FacetValues" }
    }
  },
  "$defs": {
    "FacetValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
          "additionalProperties": { "$ref": "#/$defs/FieldSlot" }
        },
        "notes": { "$ref": "weave-common.schema.json#/$defs/Annotations" }
      }
    },
    "FieldSlot": {
      "description": "필드 한 자리. 축이 없는 필드면 값 하나이고, 템플릿이 varies 를 단 필드면 byVariant 로 갈래마다 하나다. **어느 쪽이어야 하는지는 템플릿이 정한다** — 여기서는 둘 다 받고, 대조는 검사기가 한다. 갈래 값에 또 갈래를 둘 수는 없다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["filled", "empty"] },
        "value": { "$ref": "#/$defs/Value" },
        "notes": { "$ref": "weave-common.schema.json#/$defs/Annotations" },
        "byVariant": {
          "description": "축의 갈래마다 따로 있는 값. 키는 템플릿 variants 의 id 이고 빠짐도 덤도 없이 전부 덮는다.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
          "additionalProperties": { "$ref": "#/$defs/FieldValue" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["byVariant"] },
          "then": {
            "not": { "anyOf": [{ "required": ["state"] }, { "required": ["value"] }, { "required": ["notes"] }] }
          }
        },
        {
          "if": { "not": { "required": ["byVariant"] } },
          "then": { "$ref": "#/$defs/FieldValue" }
        }
      ]
    },
    "FieldValue": {
      "description": "상태는 filled 와 empty 둘뿐이다. 왜 비었는지는 주석이 글로 말한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["filled", "empty"] },
        "value": { "$ref": "#/$defs/Value" },
        "notes": { "$ref": "weave-common.schema.json#/$defs/Annotations" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "filled" } }, "required": ["state"] },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "state": { "const": "empty" } }, "required": ["state"] },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "Value": {
      "description": "선언된 shape 를 모르는 자리에서 쓰는 느슨한 합집합. 정확한 판정은 검사기가 템플릿을 들고 한다.",
      "anyOf": [
        { "$ref": "#/$defs/ValueSingle" },
        { "$ref": "#/$defs/ValueRange" },
        { "$ref": "#/$defs/ValueSeries" },
        { "$ref": "#/$defs/ValueItems" }
      ]
    },
    "ValueSingle": { "$ref": "weave-common.schema.json#/$defs/Scalar" },
    "ValueRange": {
      "description": "구간. 한쪽만 알아도 담는다.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": { "$ref": "weave-common.schema.json#/$defs/Scalar" },
        "max": { "$ref": "weave-common.schema.json#/$defs/Scalar" }
      }
    },
    "ValueSeries": {
      "description": "축 위의 점들. at 은 오름차순이고 겹치지 않는다.",
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "value"],
        "properties": {
          "at": { "$ref": "weave-common.schema.json#/$defs/Scalar" },
          "value": { "$ref": "weave-common.schema.json#/$defs/Scalar" }
        }
      }
    },
    "ValueItems": {
      "description": "반복 항목. 각 항목은 선언된 열의 부분집합을 채운다. 없는 열은 빈 칸이다.",
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "propertyNames": { "$ref": "weave-common.schema.json#/$defs/Key" },
        "additionalProperties": { "$ref": "weave-common.schema.json#/$defs/Scalar" }
      }
    }
  }
}
